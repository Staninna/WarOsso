<?xml version="1.0" encoding="utf-8"?>
<!-- Seedvault on GrapheneOS backs up the Room database (the owner's setup) and the settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
